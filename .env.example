# Configuração web do Firebase (Console > Configurações do projeto > Seus apps).
# Estes valores identificam o projeto; a segurança vem das regras do Firestore.
# Os valores abaixo servem para os emuladores locais (projeto "demo-fuba").
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-fuba
VITE_FIREBASE_APP_ID=

# true = conecta aos emuladores locais (npm run emulators). false = projeto real.
VITE_USE_EMULATORS=true

# Camada de mapa: qualquer servidor de tiles XYZ. OpenStreetMap serve para desenvolvimento/piloto.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap
